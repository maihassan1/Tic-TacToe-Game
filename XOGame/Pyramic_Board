PyramicBoard::PyramicBoard() {
    n_rows =5;
    n_cols = 5;
    board = new char*[n_rows];
    for (int i = 0; i <= n_rows; i++) {
        board [i] = new char[n_cols];
        for (int j = 0; j <= n_cols; j++)
            board[i][j] =0;
    }
}

void PyramicBoard::display_board() {
    int k=0;
    for (int i = 0; i <= 5; i++) {
        if(i%2==0){
            k++;
            continue;

        }
        cout <<setw(4*(5 - i)) << "|";
        for (int j = 0; j < i; j++) {
            cout<<"("<<i-k<<","<<j<<")";
            cout << board[i-k][j] <<"|";

        }
        cout <<endl;
    }
}
bool PyramicBoard::update_board (int x, int y, char mark){
    if (!(x < 0 || x > 2 || y < 0 || y > 4) && (board[x][y] == 0)) {
        board[x][y] = toupper(mark);
        n_moves++;
        return true;
    }
    else
        return false;
}
bool PyramicBoard::is_winner() {
    // Check for winning conditions horizontally
    for (int i = 1; i <= 2; i++) {
        if (board[i][0] == board[i][1] && board[i][1] == board[i][2]&& board[i][0] !=0) {
            return true;  // Three-in-a-row horizontally
        }
        if(board[i][4]==board[i][3] && board[i][3]==board[i][2] && board[i][4]!=0){
            return 1;
        }
    }
    if(board[2][1]==board[2][2]&&board[2][2]==board[2][3]&& board[2][1]!=0){
        return true;
    }
    // Check for winning conditions vertically
    for (int j = 0; j <= 4; j++) {
        if (board[0][0] == board[1][j] && board[1][j] == board[2][j] && board[0][0] != 0&&board[1][j]!=0&&board[2][j]!=0) {
            return true;
        }
        if(board[0][0] == board[1][j+2] && board[1][j+2] == board[2][j+4] && board[1][j+2] != 0&&board[1][j+2]!=0&&board[2][j+4]!=0){
            return true;
        }


    }


    return false;  // No winning condition

}


bool PyramicBoard::is_draw(){
    return (n_moves == 9 && !is_winner());
}
bool PyramicBoard::game_is_over(){
    return n_moves >= 9;
}
