#include<bits/stdc++.h>
using namespace std;

template<typename T>
class Set {
private:
    vector<T> data;

public:
    void addValue(T val) {
        if (find(data.begin(), data.end(), val) == data.end()) {
            data.push_back(val);
        }
    }

    void removeValue(const T& val) {
        auto it = find(data.begin(), data.end(), val);
        if (it != data.end()) {
            data.erase(it);
        }
    }

    int size() {
        return data.size();
    }

    bool findValue(T val) {
        return find(data.begin(), data.end(), val) != data.end();
    }

    T* array() {
        T* p = new T[data.size()];
        for (int i = 0; i < data.size(); i++) {
            p[i] = data[i];
        }
        return p;
    }
};
class MyClass {
private:
    int value;
public:
    MyClass() : value(0) {}
    MyClass(int val) : value(val) {}

    bool operator==(const MyClass& other) const {
        return value == other.value;
    }
    bool operator!=(const MyClass& other) const {
        return !(*this == other);
    }
};

int main() {
    Set<int> s;
    cout<<"set of int:"<<endl;
    s.addValue(5);
    s.addValue(6);
    s.addValue(7);
    s.addValue(7);
    cout<<s.findValue(3)<<endl;
    cout<<s.findValue(7)<<endl;
    cout<<s.size()<<endl;
    s.removeValue(7);
    cout<<s.size()<<endl;
    int* arr = s.array();
    for (int i = 0; i < s.size(); i++) {
        cout << arr[i] << " ";
    }
    cout << endl;
    cout<<*s.array()<<endl;
    delete[] arr;
    Set<MyClass> ob;
    cout<<"set of objrcts:"<<endl;
    ob.addValue(MyClass(1));
    ob.addValue(MyClass(2));
    ob.addValue(MyClass(3));
    cout<<ob.size()<<endl;
    ob.removeValue(MyClass(3));
    cout<<ob.size()<<endl;
    cout<<ob.findValue(MyClass(2))<<endl;
    MyClass *arrr = ob.array();
    delete[] arrr;
    Set<string> str;
    cout<<"set of strings:"<<endl;
    str.addValue("nam1");
    str.addValue("nam2");
